# @BotFather bergan token (HECH KIMGA KO'RSATMANG)
BOT_TOKEN=
# Mini App manzili: HTTPS bo'lishi shart, oxirida / bo'lmasin
WEBAPP_URL=https://sizning-domen.uz
PORT=3000
# 127.0.0.1 = faqat nginx orqali (tavsiya). Docker ichida 0.0.0.0
HOST=127.0.0.1
# 1 = to'lovsiz test rejimi (depozit bepul beriladi). Haqiqiy pulda 0 qiling (yoki admin paneldan)
TEST_MODE=1
TON_ADDRESS=
TONCENTER_KEY=
# Admin panel: https://sizning-domen.uz/admin  — KUCHLI parol qo'ying. Bo'sh bo'lsa admin panel o'chiq
ADMIN_PASSWORD=
# (ixtiyoriy) token imzolash kaliti; berilmasa har qayta ishga tushganda yangilanadi
ADMIN_SECRET=
# (ixtiyoriy) Depozit va yechish so'rovlari haqida Telegram xabar oladigan adminlar ID'lari, vergul bilan: 123456789,987654321
ADMIN_IDS=
